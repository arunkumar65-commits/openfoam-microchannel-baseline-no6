FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solidZone";
    object      e;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0]; // J/kg

internalField   uniform 131917;   // Explicit internal energy value for 293 K

boundaryField
{
    solidFront
    {
        type            zeroGradient;
    }

    solidBack
    {
        type            zeroGradient;
    }

    bottomHeatedWall
    {
        type            zeroGradient;
    }

    leftOuterWall
    {
        type            zeroGradient;
    }

    rightOuterWall
    {
        type            zeroGradient;
    }

    solidTop
    {
        type            zeroGradient;
    }

    solidZone_to_fluidZone
    {
        type            zeroGradient;
    }
}

