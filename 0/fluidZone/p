FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    fluidInlet
    {
        type            calculated;
        value           uniform 101325;
    }

    fluidOutlet
    {
        type            calculated;
        value           uniform 101325;
    }

    fluidTop
    {
        type            calculated;
        value           uniform 101325;
    }

    fluidZone_to_solidZone
    {
        type            calculated;
        value           uniform 101325;
    }
}

