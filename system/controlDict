FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Updated from legacy chtMultiRegionFoam to the modern OpenFOAM v13 modular solver driver
application     foamMultiRun;

regionSolvers
{
    fluidZone   fluid;
    solidZone   solid;
}

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         5;

deltaT          0.5;

adjustTimeStep  yes;
maxCo           10.0;
maxDi           10.0;

writeControl    adjustableRunTime;
writeInterval   1;

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

libs            ();

functions
{
}

