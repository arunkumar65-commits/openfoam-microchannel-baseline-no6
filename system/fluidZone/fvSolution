FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/fluidZone";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


thermophysicalPredictor no; 

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

   
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-05;      
        relTol          0.1;        
        maxIter         20;         
    }

    
    p_rghFinal
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
        maxIter         30;         
    }

    "(U|h).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-07;
        relTol          0.1;
    }

    "(U|h)Final"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-07;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors 3;             
    nCorrectors     2;
    nNonOrthogonalCorrectors 1;
}

relaxationFactors
{
    fields
    {
        p_rgh           0.5;        
    }
    equations
    {
        U               0.5;        
        h               0.7;
    }
}

