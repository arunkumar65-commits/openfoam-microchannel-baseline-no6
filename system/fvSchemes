FoamFile 
{
    format    ascii;
    class     dictionary;
    object     fvSchemes;
}

ddtSchemes
{
    default     steadyState;
}

gradSchemes
{
    default     Gauss linear;
}

divSchemes
{
    default      none;
    div(phi,U)   Gauss linearUpwind grad(U);
    div(phi,K)   Gauss upwind;
    div(phi,h)   Gauss upwind;
}

laplacianSchemes
{
    default      Gauss linear corrected;
}

interpolationSchemes
{
    default      linear;
}

snGradSchemes
{
    default      corrected;
}